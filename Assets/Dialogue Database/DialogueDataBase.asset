          \u043A\u0443\u0437\u043D\u0435\u0446\u0430? \u0422\u0430\u043A \u0432\u0435\u0434\u044C.
          \u041F\u0440\u043E\u0448\u0443 \u043F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435,
          \u043F\u043E\u0432\u0435\u0440\u044C \u044F \u0432 \u0434\u043E\u043B\u0433\u0443
          \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u0440\u043E\u0448\u0443 \u043F\u043E\u043C\u043E\u0433\u0438."
