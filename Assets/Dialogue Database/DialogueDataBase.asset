  items:
  - id: 1
    fields:
    - title: Name
      value: SafeMan_0
      type: 0
      typeString: CustomFieldType_Text
    - title: Pictures
      value: '[]'
      type: 3
      typeString: CustomFieldType_Files
    - title: Description
      value: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043C\u0443\u0436\u0438\u043A\u0443,
        \u0443\u0431\u0438\u0432 \u0440\u0430\u0437\u044A\u0435\u0440\u0451\u043D\u043D\u043E\u0433\u043E
        \u0431\u044B\u043A\u0430"
      type: 0
      typeString: CustomFieldType_Text
    - title: Success Description
      value: "\u0412\u044B \u0443\u0431\u0438\u043B\u0438 \u0431\u044B\u043A\u0430,
        \u0442\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u0441\u043F\u0430\u0441\u043B\u0438
        \u043C\u0443\u0436\u0438\u043A\u0430"
      type: 0
      typeString: CustomFieldType_Text
    - title: Failure Description
      value: "\u0412\u044B \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
        \u043E\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0431\u044B\u043A\u0430,
        \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442 \u0447\u0442\u043E \u0441\u0442\u0430\u043D\u0435\u0442
        \u0441 \u043C\u0443\u0436\u0438\u043A\u043E\u043C"
      type: 0
      typeString: CustomFieldType_Text
    - title: State
      value: unassigned
      type: 0
      typeString: CustomFieldType_QuestState
    - title: Is Item
      value: False
      type: 2
      typeString: CustomFieldType_Boolean
    - title: Display Name
      value: "\u0423\u0431\u0435\u0439\u0442\u0435 \u0431\u044B\u043A\u0430"
      type: 0
      typeString: CustomFieldType_Text
    - title: Trackable
      value: True
      type: 2
      typeString: CustomFieldType_Boolean
    - title: Track
      value: True
      type: 2
      typeString: CustomFieldType_Boolean
    - title: Entry Count
      value: 1
      type: 1
      typeString: CustomFieldType_Number
    - title: Entry 1 State
      value: active
      type: 0
      typeString: CustomFieldType_QuestState
    - title: Entry 1
      value: '[var=SafeMan.BullisLive] == true'
      type: 0
      typeString: CustomFieldType_Text
  - id: 2
