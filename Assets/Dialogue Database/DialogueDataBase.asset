        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\u0413\u043B\u0443\u043F\u043E\u0441\u0442\u044C \u044F \u0441\u0434\u0435\u043B\u0430\u043B,
          \u0443\u0436\u0430\u0441\u043D\u0443\u044E \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u044C.
          \u0420\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u0441\u043A\u043E\u0442
          \u043E\u0442\u0431\u0435\u0440\u0443\u0442 \u0438 \u0441\u0447\u0435\u0440\u043D\u0438\u043B
          \u0434\u0443\u0448\u043E\u0439. \u0416\u0435\u043D\u0443 \u0441 \u0434\u0435\u0442\u044C\u043C\u0438
          \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0441\u043F\u0430\u0441\u0430\u0442\u044C\u0441\u044F
          \u0441\u043E \u0432\u0441\u0435\u043C\u0438, \u0430 \u0441\u0430\u043C
          \u043A \u043B\u0435\u0441\u043D\u0438\u043A\u0443 \u043F\u043E\u0431\u0435\u0436\u0430\u043B
          \u043D\u0430\u0431\u0440\u0430\u043B \u0442\u0440\u0430\u0432 \u0432\u0441\u0435\u0445,
          \u0447\u0442\u043E \u043C\u043E\u0433 \u0438 \u043A\u043E\u0440\u043E\u0432
          \u043F\u043E\u0448\u0451\u043B \u043A\u043E\u0440\u043C\u0438\u0442\u044C,
          \u0434\u0443\u043C\u0430\u043B \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442
          \u0432\u0441\u0435, \u043D\u0438\u0447\u0435\u0433\u043E \u044D\u0442\u0438\u043C
          \u0442\u0432\u0430\u0440\u044F\u043C \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044E.
          \u0414\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0451\u0440\u0442
          \u044F \u0447\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043B \u0432
          \u044D\u0442\u0438\u0445 \u0442\u0440\u0430\u0432\u0430\u0445. \u0411\u044B\u043A
          \u0442\u043E \u043C\u043E\u0439, \u043D\u0435 \u043F\u043E\u0434\u043E\u0445,
          \u0431\u0443\u0434\u044C \u043E\u043D \u043D\u0435\u043B\u0430\u0434\u0435\u043D,
          \u043E\u0437\u0432\u0435\u0440\u0435\u043B\u0430 \u0441\u043A\u043E\u0442\u0438\u043D\u0430
          \u0441\u043A\u0430\u0447\u0435\u0442 \u0432 \u0437\u0430\u0433\u043E\u043D\u0435
          \u043B\u044F\u0433\u0430\u0435\u0442\u0441\u044F. \u041F\u0440\u043E\u0448\u0443,
          \u0443\u0431\u0435\u0439 \u0435\u0433\u043E, \u0443\u0431\u0435\u0439 \u044D\u0442\u043E\u0433\u043E
          \u0431\u0435\u0441\u0430. \u0418 \u0437\u0430\u0431\u0438\u0440\u0430\u0439,
          \u0447\u0442\u043E \u0445\u043E\u0447\u0435\u0448\u044C. \u041C\u043D\u0435
          \u0443\u0436\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432
          \u043B\u0435\u0441 \u0431\u0435\u0436\u0430\u0442\u044C. \u0421\u0435\u043C\u044C\u044E
          \u044F \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B \u0441\u0430\u043C
          \u0443\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0443\u043D\u0435\u0441\u0443."
