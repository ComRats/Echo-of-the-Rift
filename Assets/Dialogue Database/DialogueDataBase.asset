      type: 0
      typeString: CustomFieldType_Text
    - title: Failure Description
      value: "\u0412\u044B \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
        \u043E\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0431\u044B\u043A\u0430,
